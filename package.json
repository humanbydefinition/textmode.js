{
	"name": "textmode.js",
	"version": "0.17.0",
	"description": "textmode.js is a lightweight creative coding library for creating real-time ASCII art on the web.",
	"type": "module",
	"engines": {
		"node": ">=20.8.1"
	},
	"main": "./dist/textmode.umd.js",
	"module": "./dist/textmode.esm.js",
	"types": "./dist/types/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/textmode.esm.js",
			"require": "./dist/textmode.umd.js"
		}
	},
	"files": [
		"dist",
		"THIRD_PARTY_NOTICES.md"
	],
	"scripts": {
		"dev": "vite --port 5177 --host",
		"build:bundle": "vite build",
		"build:types": "tsc -p tsconfig.build.json",
		"build": "npm run build:bundle && npm run build:types",
		"check": "npm run check:format && npm run check:deps && npm run lint && npm run lint:md && npm run check:types && npm run check:dist-types && npm run check:api-docs && npm run check:docs && npm run check:examples && npm run test && npm run build",
		"docs:links:add": "textmode-add-api-links",
		"check:api-docs": "textmode-check-api-docs",
		"check:docs": "typedoc --emit none --treatWarningsAsErrors --treatValidationWarningsAsErrors",
		"check:examples": "textmode-check-examples",
		"dev:docs": "typedoc --watch",
		"build:docs": "typedoc",
		"preview": "vite preview",
		"test": "vitest run",
		"test:unit": "vitest run --project unit-node --project unit-jsdom",
		"test:integration": "vitest run --project integration-jsdom",
		"test:contracts": "vitest run --project contracts-node",
		"test:tooling": "vitest run --project tooling-node",
		"test:watch": "vitest",
		"test:ui": "vitest --ui",
		"test:coverage": "vitest run --coverage",
		"audit:runtime": "npm audit --omit=dev",
		"audit:dev": "npm audit",
		"format": "prettier --write .",
		"check:format": "prettier --check .",
		"check:types": "tsc --noEmit",
		"check:dist-types": "npm run build:types && tsc --noEmit -p tsconfig.dist.json",
		"lint:md": "markdownlint-cli2",
		"lint:md:fix": "markdownlint-cli2 --fix",
		"lint": "eslint src",
		"lint:jsdoc": "npm run lint",
		"contributors:add": "all-contributors add",
		"contributors:generate": "all-contributors generate",
		"prepare": "husky && install-husky",
		"prepack": "npm run build && tsc --noEmit -p tsconfig.dist.json",
		"check:deps": "check-deps"
	},
	"devDependencies": {
		"@commitlint/cli": "^20.5.0",
		"@commitlint/config-conventional": "^20.5.0",
		"@eslint/js": "^9.39.4",
		"@mapwhit/glsl-minify": "^1.0.0",
		"@rollup/plugin-terser": "^1.0.0",
		"@semantic-release/exec": "^7.1.0",
		"@semantic-release/github": "^12.0.9",
		"@semantic-release/git": "^10.0.1",
		"@types/node": "^24.0.13",
		"@vitest/coverage-v8": "^3.2.4",
		"@vitest/ui": "^3.1.2",
		"all-contributors-cli": "^6.26.1",
		"eslint": "^9.39.2",
		"eslint-plugin-jsdoc": "^62.9.0",
		"globals": "^17.5.0",
		"husky": "^9.1.7",
		"jsdom": "^27.4.0",
		"lint-staged": "^16.4.0",
		"markdownlint-cli2": "^0.22.1",
		"markdownlint-cli2-formatter-default": "^0.0.6",
		"prettier": "^3.8.3",
		"semantic-release": "^25.0.3",
		"typedoc": "^0.28.19",
		"typedoc-plugin-frontmatter": "^1.3.1",
		"typedoc-plugin-markdown": "^4.11.0",
		"typedoc-vitepress-theme": "^1.1.2",
		"typescript": "^5.9.2",
		"typescript-eslint": "^8.59.0",
		"vite": "^6.3.4",
		"vitest": "^3.1.2",
		"@textmode/commitlint-config": "^0.1.0",
		"@textmode/eslint-config": "^0.1.0",
		"@textmode/markdownlint-config": "^0.1.0",
		"@textmode/prettier-config": "^0.1.0",
		"@textmode/release-config": "^0.1.0",
		"@textmode/tooling-scripts": "^0.2.0",
		"@textmode/tsconfig": "^0.1.0",
		"@textmode/vitest-config": "^0.1.1"
	},
	"keywords": [
		"ascii",
		"petscii",
		"textmode",
		"canvas",
		"webgl",
		"creative-coding",
		"art",
		"design",
		"graphics",
		"ascii-art"
	],
	"author": "humanbydefinition <hello@textmode.art> (https://code.textmode.art)",
	"license": "MIT",
	"homepage": "https://code.textmode.art",
	"lint-staged": {
		"*": "prettier --ignore-unknown --write"
	},
	"prettier": "@textmode/prettier-config",
	"commitlint": {
		"extends": [
			"@textmode/commitlint-config"
		]
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/humanbydefinition/textmode.js-dev.git"
	},
	"bugs": {
		"url": "https://github.com/humanbydefinition/textmode.js/issues"
	},
	"peerDependencies": {}
}
